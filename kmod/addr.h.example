/*
 * addr.h - kernel symbol addresses for the target device
 *
 * Copy this file to addr.h and fill in the values printed by
 * scripts/gen_addr.sh (which reads /proc/kallsyms on the phone).
 *
 * All five are plain text symbols, so they are present in /proc/kallsyms even
 * with CONFIG_KALLSYMS_ALL=n.
 *
 * A_MODULE_LAYOUT_CRC is NOT a kallsyms lookup: it is the crc that the running
 * kernel compiled into __kcrctab for "module_layout".  The easiest way to get
 * it is to read the __versions section of any stock .ko shipped on the device:
 *
 *     adb pull /system/lib/modules/ansi_cprng.ko
 *     python3 scripts/get_module_layout_crc.py ansi_cprng.ko
 */
#define A_REGULATOR_GET      0x00000000UL  /* regulator_get      */
#define A_DEV_GET_DRVDATA    0x00000000UL  /* dev_get_drvdata    */
#define A_MMC_DETECT_CHANGE  0x00000000UL  /* mmc_detect_change  */
#define A_PRINTK             0x00000000UL  /* printk             */
#define A_MSLEEP             0x00000000UL  /* msleep             */

#define A_MODULE_LAYOUT_CRC  0x00000000UL
